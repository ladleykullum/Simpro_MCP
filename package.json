{
  "name": "simpro-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets Claude work with a Simpro account: jobs, schedules, quotes, invoices and customers.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "simpro-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "login": "node dist/login.js",
    "check": "node dist/check.js",
    "mock": "node dist/mock/run.js",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
