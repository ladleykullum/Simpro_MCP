# ---- Simpro account (required) ----
# The address you log in to, nothing after .com
SIMPRO_BASE_URL=https://yourbuild.simprosuite.com
# Almost always 0 for a single-company build
SIMPRO_COMPANY_ID=0

# ---- Sign-in: choose ONE ----
# A) OAuth app (recommended). Simpro: Setup > Integrations > API > New. Use "Authorization Code".
SIMPRO_CLIENT_ID=
SIMPRO_CLIENT_SECRET=
# Local mode redirect URI to register in Simpro: http://localhost:8237/callback
# Hosted mode redirect URI to register in Simpro: <PUBLIC_URL>/oauth/simpro/callback
# SIMPRO_AUTH_REDIRECT_PORT=8237
# SIMPRO_AUTH_MODE=authorization_code   # or client_credentials (no user, local only)

# B) Legacy API key (local mode only)
# SIMPRO_API_KEY=

# ---- Safety ----
# confirm (default): changes are previewed and need your OK
# read_only: no changes at all     auto: changes run immediately
SIMPRO_WRITE_MODE=confirm
# Deleting is off unless you set this to true
SIMPRO_ALLOW_DELETE=false

# ---- Hosted mode only ----
# SIMPRO_TRANSPORT=http
# PUBLIC_URL=https://simpro-mcp.yourdomain.co.nz
# Long random string (openssl rand -hex 32). If unset, one is generated in the state dir.
# SIMPRO_SECRET=
# PORT=3000

# ---- Tuning (optional) ----
# SIMPRO_PAGE_SIZE=30
# SIMPRO_MAX_RESULT_CHARS=60000
# SIMPRO_RATE_LIMIT=8
